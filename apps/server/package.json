{
  "name": "server",
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "test": "tsx --test src/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs"
  },
  "dependencies": {
    "@callus/api": "workspace:*",
    "@callus/auth": "workspace:*",
    "@callus/db": "workspace:*",
    "@callus/env": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "evlog": "^2.27.1",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@callus/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.1",
    "typescript": "catalog:"
  }
}
